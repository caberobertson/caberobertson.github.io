---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Contact | Cabe Robertson"
    description="Contact Cabe Robertson, an Electrical Engineering student at NMSU seeking a Summer 2027 internship in RF, embedded, and mission systems hardware. U.S. Person, ITAR/EAR eligible."
    ogTitle="Contact | Cabe Robertson"
    ogDescription="Let's connect. Actively seeking internship and co-op roles."
>
<main id="main">
        <section class="section centered">
            <div class="container">
                <div class="section-head reveal in">
                    <span class="section-index">01</span>
                    <h1 class="section-title">Let's Connect</h1>
                </div>
                <p class="section-sub reveal in">I am actively seeking a <strong>Summer 2027 internship</strong> in RF, embedded, and mission systems hardware. Whether you have an opportunity or just want to chat engineering, I'd love to hear from you.</p>

                <div class="chip-row reveal" style="justify-content:center">
                    <span class="chip"><strong>U.S. Person</strong>, ITAR/EAR eligible</span>
                    <span class="chip">Eligible for U.S. security clearance</span>
                    <span class="chip">Open to relocation</span>
                    <span class="chip">Typical reply within 24h</span>
                </div>

                <div class="contact-list">
                    <div class="contact-row reveal">
                        <span class="row-index" aria-hidden="true">01</span>
                        <div class="row-text">
                            <span class="label">Email</span>
                            <h4><a href="mailto:caberobertson@gmail.com">caberobertson@gmail.com</a></h4>
                        </div>
                        <button type="button" class="copy-chip" data-copy="caberobertson@gmail.com" aria-label="Copy email address">copy</button>
                    </div>

                    <div class="contact-row reveal" data-delay="1">
                        <span class="row-index" aria-hidden="true">02</span>
                        <div class="row-text">
                            <span class="label">Phone</span>
                            <h4>575-644-4703</h4>
                        </div>
                        <button type="button" class="copy-chip" data-copy="575-644-4703" aria-label="Copy phone number">copy</button>
                    </div>

                    <div class="contact-row reveal" data-delay="2">
                        <span class="row-index" aria-hidden="true">03</span>
                        <div class="row-text">
                            <span class="label">Location</span>
                            <h4>Las Cruces, NM (open to relocation)</h4>
                        </div>
                    </div>

                    <a href="https://www.linkedin.com/in/caberobertson/" target="_blank" rel="noopener" class="contact-row is-link reveal" data-delay="3">
                        <span class="row-index" aria-hidden="true">04</span>
                        <div class="row-text">
                            <span class="label">Network</span>
                            <h4>Connect on LinkedIn</h4>
                        </div>
                    </a>

                    <a href="Cabe_Robertson_Resume.pdf" target="_blank" class="contact-row is-link reveal" data-delay="3">
                        <span class="row-index" aria-hidden="true">05</span>
                        <div class="row-text">
                            <span class="label">Resume</span>
                            <h4>Download one-page PDF</h4>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
