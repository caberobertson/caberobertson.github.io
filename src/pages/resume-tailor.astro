---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Resume Tailor | Cabe Robertson"
    description="Turns a photo of a job posting and a resume into a one-page LaTeX resume aimed at that role."
    ogTitle="Resume Tailor | Cabe Robertson"
    ogDescription="Photo of a job posting in, tailored one-page LaTeX resume out."
    noindex
>
<main id="main">
    <section class="section">
        <div class="container">
            <div class="section-head reveal in">
                <span class="section-index">TOOL</span>
                <h1 class="section-title">Resume Tailor</h1>
            </div>
            <p class="section-sub reveal in">Give it a picture of a job posting and a resume. It rewrites the resume for that role as one page of LaTeX, pulls in skills your experience implies, and shows its reasoning so you can cut anything you would not defend.</p>

            <div class="rt-grid">
                <div class="panel">
                    <span class="panel-tag">01 Job posting</span>
                    <h2>The role</h2>
                    <div class="rt-fields">
                        <label class="rt-field">
                            <span>Company name</span>
                            <input type="text" id="rt-company" autocomplete="organization" spellcheck="false">
                        </label>
                        <label class="rt-field">
                            <span>Role title (optional)</span>
                            <input type="text" id="rt-role" autocomplete="off">
                        </label>
                    </div>
                    <div class="rt-drop" id="rt-drop">
                        <p>Drop photos or screenshots of the requirements here, or paste one from the clipboard.</p>
                        <div class="rt-actions">
                            <label class="btn" for="rt-files">Choose images</label>
                            <input type="file" id="rt-files" class="rt-hidden" accept="image/*" multiple>
                            <label class="btn" for="rt-camera">Take a photo</label>
                            <input type="file" id="rt-camera" class="rt-hidden" accept="image/*" capture="environment">
                        </div>
                    </div>
                    <div class="rt-thumbs" id="rt-thumbs" aria-live="polite"></div>
                    <label class="rt-field">
                        <span>Or paste the posting text</span>
                        <textarea id="rt-posting-text" rows="4" spellcheck="false"></textarea>
                    </label>
                </div>

                <div class="panel">
                    <span class="panel-tag">02 Resume</span>
                    <h2>Your resume</h2>
                    <div class="rt-actions">
                        <button type="button" class="btn" id="rt-load-mine">Load Cabe's resume</button>
                        <label class="btn" for="rt-resume-file">Upload PDF, .tex or .txt</label>
                        <input type="file" id="rt-resume-file" class="rt-hidden" accept=".pdf,.tex,.txt,.md,application/pdf,text/plain">
                    </div>
                    <p class="rt-hint" id="rt-resume-file-name" aria-live="polite"></p>
                    <label class="rt-field">
                        <span>Resume text</span>
                        <textarea id="rt-resume" rows="12" spellcheck="false"></textarea>
                    </label>
                    <label class="rt-check">
                        <input type="checkbox" id="rt-use-site" checked>
                        <span>Also use this site's project write-ups, build log and skills pages as source material. Leave this on for Cabe's resume and turn it off for anyone else's.</span>
                    </label>
                </div>
            </div>

            <div class="panel rt-run">
                <span class="panel-tag">03 Generate</span>
                <h2>Run it</h2>
                <div class="rt-fields">
                    <label class="rt-field">
                        <span>Anthropic API key</span>
                        <input type="password" id="rt-key" autocomplete="current-password" spellcheck="false">
                    </label>
                    <label class="rt-field">
                        <span>Model</span>
                        <select id="rt-model">
                            <option value="claude-opus-5-5" selected>Claude Opus 5.5</option>
                            <option value="claude-fable-5-2">Claude Fable 5.2 (strongest, costs more)</option>
                            <option value="claude-sonnet-5-5">Claude Sonnet 5.5 (faster, cheaper)</option>
                        </select>
                    </label>
                </div>
                <label class="rt-check">
                    <input type="checkbox" id="rt-remember">
                    <span>Remember the key in this browser</span>
                </label>
                <p class="rt-hint">The page has no server. Your key, the posting and the resume go from this browser straight to the Claude API and nowhere else. Create a key at <a href="https://console.anthropic.com/settings/keys" target="_blank" rel="noopener">console.anthropic.com</a>.</p>
                <div class="rt-actions">
                    <button type="button" class="btn btn-primary" id="rt-generate">Tailor my resume</button>
                    <button type="button" class="btn" id="rt-stop" hidden>Stop</button>
                </div>
                <p class="rt-status" id="rt-status" role="status" aria-live="polite"></p>
            </div>

            <div id="rt-output">
                <div class="rt-grid rt-grid--out">
                    <div class="panel">
                        <span class="panel-tag">LaTeX</span>
                        <h2>Source</h2>
                        <label class="rt-field">
                            <span>Editable. The preview follows as you type.</span>
                            <textarea id="rt-editor" class="rt-editor" rows="28" spellcheck="false"></textarea>
                        </label>
                        <div class="rt-actions">
                            <button type="button" class="btn btn-primary" id="rt-compile">Compile PDF</button>
                            <button type="button" class="btn" id="rt-overleaf">Open in Overleaf</button>
                            <button type="button" class="btn" id="rt-download">Download .tex</button>
                            <button type="button" class="btn" id="rt-copy">Copy</button>
                        </div>
                        <p class="rt-hint">Compile PDF sends the LaTeX to the public service latex.ytotech.com. Open in Overleaf sends it to Overleaf. Neither happens until you press the button.</p>
                    </div>
                    <div class="panel">
                        <span class="panel-tag">Preview</span>
                        <h2>Quick preview</h2>
                        <div class="rt-paper" id="rt-preview"><p class="rt-empty">The resume preview appears here.</p></div>
                        <p class="rt-hint">An approximation drawn in the browser. Compile for exact spacing and to confirm it fits one page.</p>
                    </div>
                </div>

                <div class="panel rt-run" id="rt-pdf-wrap" hidden>
                    <span class="panel-tag">PDF</span>
                    <h2>Compiled PDF</h2>
                    <iframe id="rt-pdf" class="rt-pdf" title="Compiled resume PDF"></iframe>
                    <div class="rt-actions">
                        <a class="btn" id="rt-pdf-save" href="#main">Download PDF</a>
                    </div>
                </div>

                <div class="panel rt-run">
                    <span class="panel-tag">Revise</span>
                    <h2>Ask for changes</h2>
                    <div class="rt-revise">
                        <label class="rt-field">
                            <span>For example: cut it to fit one page, lead with the RF work, drop the objective</span>
                            <input type="text" id="rt-revise" autocomplete="off">
                        </label>
                        <button type="button" class="btn" id="rt-revise-btn">Revise</button>
                    </div>
                    <div class="rt-report" id="rt-report" aria-live="polite"></div>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
    import '../scripts/tailor.js';
</script>
</BaseLayout>

<style is:global>
    .rt-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem; margin-top: 2rem; }
    .rt-grid .panel h2, .rt-run h2 { margin: 0.4rem 0 1rem; font-size: 1.15rem; }
    .rt-run { margin-top: 1.6rem; }
    .panel [hidden], .panel[hidden] { display: none; }
    .rt-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .rt-field { display: block; margin: 0 0 1rem; }
    .rt-field > span { display: block; font-family: var(--font-mono); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); margin-bottom: 6px; }
    .rt-field input, .rt-field textarea, .rt-field select {
        width: 100%; box-sizing: border-box; padding: 10px 12px; font: inherit; font-size: 0.92rem;
        color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius);
    }
    .rt-field textarea { resize: vertical; line-height: 1.45; }
    .rt-field input:focus-visible, .rt-field textarea:focus-visible, .rt-field select:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
    .rt-editor { font-family: var(--font-mono) !important; font-size: 0.78rem !important; white-space: pre; overflow: auto; tab-size: 2; }
    .rt-hidden { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; clip-path: inset(50%); }
    .rt-hidden:focus-visible + .btn, .btn:has(+ .rt-hidden:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
    .rt-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 1rem; }
    .rt-drop { border: 1px dashed var(--muted); padding: 1.1rem; margin: 0 0 1rem; }
    .rt-drop.is-over { border-color: var(--accent); background: var(--accent-soft); }
    .rt-drop p { margin: 0 0 0.9rem; color: var(--muted); font-size: 0.9rem; }
    .rt-drop .rt-actions { margin: 0; }
    .rt-thumbs { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 1rem; }
    .rt-thumbs:empty { display: none; }
    .rt-thumb { width: 96px; border: 1px solid var(--line); }
    .rt-thumb img { display: block; width: 100%; height: 96px; object-fit: cover; object-position: top; }
    .rt-thumb button { width: 100%; padding: 5px 0; font: 600 0.68rem var(--font-mono); text-transform: uppercase; color: var(--ink); background: var(--bg); border: 0; border-top: 1px solid var(--line); cursor: pointer; }
    .rt-thumb button:hover { color: var(--danger); }
    .rt-check { display: flex; gap: 10px; align-items: flex-start; font-size: 0.88rem; color: var(--muted); margin: 0 0 1rem; }
    .rt-check input { margin-top: 3px; accent-color: var(--accent-fill); }
    .rt-hint, .rt-note { font-size: 0.82rem; color: var(--muted); margin: 0 0 1rem; }
    .rt-hint:empty, .rt-status:empty { display: none; }
    .rt-hint a { color: var(--accent); }
    .rt-status { margin: 0; font-family: var(--font-mono); font-size: 0.84rem; color: var(--accent); }
    .rt-status.is-error { color: var(--danger); }
    .rt-revise { display: flex; gap: 0.8rem; align-items: flex-end; }
    .rt-revise .rt-field { flex: 1; margin: 0; }
    .rt-report h3 { font-size: 0.95rem; margin: 1.4rem 0 0.6rem; }
    .rt-report pre { white-space: pre-wrap; font-size: 0.8rem; color: var(--muted); }
    .rt-pdf { width: 100%; height: 80vh; border: 1px solid var(--line); background: #fff; margin-bottom: 1rem; }

    /* The sheet is always black on white, whichever site theme is active:
       it stands in for a printed page. */
    .rt-paper {
        background: #fff; color: #111; padding: 26px 28px; margin: 0 0 1rem; min-height: 420px;
        font-family: 'Latin Modern Roman', 'Computer Modern', Georgia, 'Times New Roman', serif; font-size: 11.5px; line-height: 1.32;
        overflow-wrap: anywhere;
    }
    .rt-paper header { text-align: center; margin-bottom: 4px; }
    .rt-paper .rt-name { font-size: 22px; font-weight: 700; }
    .rt-paper .rt-contact { font-size: 10.5px; }
    .rt-paper h3 { font: 700 11.5px/1.3 inherit; font-family: inherit; text-transform: uppercase; letter-spacing: 0.3px; color: #111; border-bottom: 1px solid #111; margin: 9px 0 4px; padding-bottom: 1px; }
    .rt-paper p { margin: 0; color: #111; }
    .rt-paper .rt-row { display: flex; justify-content: space-between; gap: 12px; }
    .rt-paper .rt-row span:last-child { text-align: right; flex-shrink: 0; max-width: 45%; }
    .rt-paper .rt-entry { margin-top: 3px; }
    .rt-paper .rt-entry span:first-child { font-weight: 700; }
    .rt-paper ul { margin: 1px 0 0; padding-left: 16px; font-size: 10.5px; }
    .rt-paper li { margin: 0; color: #111; }
    .rt-paper a { color: inherit; text-decoration: none; }
    .rt-paper .rt-empty { color: #666; font-family: var(--font-body); }

    @media (max-width: 860px) {
        .rt-grid, .rt-fields { grid-template-columns: 1fr; }
        .rt-revise { flex-direction: column; align-items: stretch; }
    }
</style>
