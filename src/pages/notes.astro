---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PERSON_REF, breadcrumbs, graph } from '../lib/schema';

// Newest first. Drafts never reach the build.
const notes = (await getCollection('notes'))
    .filter((n) => !n.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const schema = graph(
    {
        '@type': 'Blog',
        name: 'Build Log',
        description: 'One engineering decision per entry, the evidence behind it, and what it cost to get wrong.',
        url: 'https://caberobertson.github.io/notes.html',
        author: PERSON_REF,
        blogPost: notes.map((n) => ({
            '@type': 'TechArticle',
            headline: n.data.title,
            description: n.data.summary,
            datePublished: n.data.date.toISOString().slice(0, 10),
            url: `https://caberobertson.github.io/notes/${n.id}.html`,
        })),
    },
    breadcrumbs([{ name: 'Home', href: '/' }, { name: 'Build Log' }]),
);

const fmt = (d: Date) =>
    d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
    title="Build Log | Cabe Robertson"
    description="Short engineering notes from Cabe Robertson: one decision per entry, the evidence behind it, and what it cost to get wrong. Sensor calibration, detection thresholds, and field testing."
    ogTitle="Build Log | Cabe Robertson"
    ogDescription="One engineering decision per entry, the evidence behind it, and what it cost to get wrong."
    ogCard="notes"
>
    <script is:inline type="application/ld+json" slot="head" set:html={schema} />

    <main id="main">
        <section class="section">
            <div class="container">
                <div class="section-head reveal in">
                    <span class="section-index">01</span>
                    <h1 class="section-title">Build Log</h1>
                </div>
                <p class="section-sub reveal in">
                    One decision per entry: what I got wrong, the evidence that showed it, and what
                    replaced it. Every note points back at the project page carrying the numbers.
                </p>

                <ul class="note-list">
                    {notes.map((n) => (
                        <li class="note-item reveal in">
                            <a class="note-link" href={`/notes/${n.id}.html`}>
                                <time class="note-date" datetime={n.data.date.toISOString().slice(0, 10)}>
                                    {fmt(n.data.date)}
                                </time>
                                <span class="note-body">
                                    <span class="note-title">{n.data.title}</span>
                                    <span class="note-summary">{n.data.summary}</span>
                                    <span class="tags">
                                        {n.data.tags.map((t) => <span class="tag">{t}</span>)}
                                    </span>
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .note-list { list-style: none; padding: 0; margin: var(--space-5) 0 0; border-top: 1px solid var(--line); }

    .note-link {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: var(--space-4);
        padding: var(--space-5) 0;
        border-bottom: 1px solid var(--line);
        text-decoration: none;
        color: inherit;
        transition: background 0.2s var(--ease-out);
    }

    .note-link:hover, .note-link:focus-visible { background: var(--accent-soft); }

    .note-date {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        color: var(--accent);
        padding-top: 5px;
    }

    .note-body { display: flex; flex-direction: column; gap: var(--space-3); }

    .note-title {
        font-family: var(--font-display);
        font-size: 1.22rem;
        font-weight: 600;
        color: var(--ink);
    }

    .note-link:hover .note-title { color: var(--accent); }
    .note-summary { color: var(--ink-dim); max-width: 72ch; }

    @media (max-width: 600px) {
        .note-link { grid-template-columns: 1fr; gap: var(--space-2); }
        .note-date { padding-top: 0; }
    }
</style>
