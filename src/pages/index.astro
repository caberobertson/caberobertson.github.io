---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScan from '../components/HeroScan.astro';
import FlagshipVideo from '../components/FlagshipVideo.astro';

// Person schema, carried over verbatim from the hand-written site.
const personSchema = {
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": "https://caberobertson.github.io/#cabe",
        "name": "Cabe Robertson",
        "givenName": "Cabe",
        "familyName": "Robertson",
        "url": "https://caberobertson.github.io/",
        "image": "https://caberobertson.github.io/photo2.jpg",
        "email": "caberobertson@gmail.com",
        "telephone": "+1-575-644-4703",
        "jobTitle": "Electrical Engineering Student",
        "description": "Electrical Engineering student (Communications & Signal Processing) at New Mexico State University, seeking a Summer 2027 internship. Hands-on RF, embedded, and sensor-fusion experience across four engineering roles. IEEE MYOSA 6.0 finalist presenting live hardware at IEEE SENSORS 2026.",
        "alumniOf": {
            "@type": "CollegeOrUniversity",
            "name": "New Mexico State University"
        },
        "award": "IEEE MYOSA 6.0 Finalist (1 of 7 teams worldwide), IEEE SENSORS 2026",
        "seeks": {
            "@type": "Demand",
            "name": "Summer 2027 Electrical Engineering Internship"
        },
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Las Cruces",
            "addressRegion": "NM",
            "addressCountry": "US"
        },
        "knowsAbout": ["Electrical Engineering", "Signal Processing", "Sensor Fusion", "Embedded Systems", "ESP32 Firmware", "Bluetooth Low Energy", "PCB Design", "FPGA", "Computer Vision", "RF Communications", "Electronic Warfare", "EEG Biopotential Recording", "Design of Experiments"],
        "sameAs": [
            "https://www.linkedin.com/in/caberobertson/",
            "https://github.com/caberobertson"
        ]
    };
---

<BaseLayout
    title="Cabe Robertson | Electrical Engineering Portfolio"
    description="Cabe Robertson, an Electrical Engineering student (Communications & Signal Processing) at New Mexico State University. Seeking a Summer 2027 internship in RF, embedded, and sensor-fusion hardware. IEEE MYOSA 6.0 finalist. U.S. Person, ITAR/EAR eligible."
    ogTitle="Cabe Robertson | Electrical Engineering Portfolio"
    ogDescription="EE student at NMSU seeking a Summer 2027 internship in RF, embedded, and sensor fusion. IEEE MYOSA 6.0 finalist presenting at IEEE SENSORS 2026."
>
    <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(personSchema)} />
<main id="main">
        <!-- Scan strip. Replaces the previous two-column hero + spec block: the
             old layout pushed the metrics and the flagship demo below the fold
             on a phone. PROPOSED CHANGE, for review: the rotating typed role
             line was retired in favour of one fixed identity line, since a
             cycling string is harder to read in a 7-second scan. Its phrases
             were: "RF & Embedded Systems" / "Sensor Fusion & Signal Processing"
             / "EE Student @ NMSU" / "IEEE NMSU Vice President". The spec-block
             rows (Role/Seeking/Graduation/Clearance/Location) are now the
             single mono status line. -->
        <HeroScan />

        <FlagshipVideo />

        <!-- At a glance -->
        <section class="section">
            <div class="container">
                <div class="section-head reveal">
                    <span class="section-index">02</span>
                    <h2 class="section-title">At a Glance</h2>
                </div>
                <p class="section-sub reveal">Electrical Engineering student concentrating in Communications &amp; Signal Processing, with hands-on RF, embedded, and sensor-fusion work across four engineering roles.</p>

                <div class="chip-row reveal">
                    <span class="chip"><strong>U.S. Person</strong>, ITAR/EAR eligible</span>
                    <span class="chip">Eligible for U.S. security clearance</span>
                    <span class="chip">Available Summer 2027</span>
                    <span class="chip">Open to relocation</span>
                </div>


                <ul class="highlight-list reveal">
                    <li><span class="hl-mark">RF</span><span>Built and fielded a <strong>$219 RF communication-jamming demonstrator</strong> for law-enforcement and defense clients, ~56% cheaper than the $500 setup it replaced.</span></li>
                    <li><span class="hl-mark">EMBEDDED</span><span>Own the <strong>ESP32/MPU6050 detection firmware</strong> on CrashGuard, recovering dynamic acceleration from raw accelerometer counts and tuning the threshold and confirmation window so ordinary handling cannot raise a false alert.</span></li>
                    <li><span class="hl-mark">TEST</span><span>Ran a benchtop <strong>design of experiments</strong> across duct and filter configurations, identifying the setup that cut acoustic noise ~10&nbsp;dB and raised airflow 20% versus stock.</span></li>
                    <li><span class="hl-mark">DSP</span><span>Developed Python simulations of <strong>linear-algebra channel decoding</strong>, validating bit-error-rate performance across encoding schemes under noise.</span></li>
                    <li><span class="hl-mark">LEAD</span><span><strong>Tripled IEEE chapter membership</strong> from 10 to 30+ and lead a $50,000 fundraising initiative for the ECE department.</span></li>
                </ul>
            </div>
        </section>

        <!-- About + Education -->
        <section class="section">
            <div class="container">
                <div class="section-head reveal">
                    <span class="section-index">03</span>
                    <h2 class="section-title">About Me</h2>
                </div>
                <div class="grid-2">
                    <div class="panel about-card reveal">
                        <span class="panel-tag">&sect; About</span>
                        <p>I am an Electrical Engineering student concentrating in <strong>Communications &amp; Signal Processing</strong> at <strong>New Mexico State University</strong> (expected Dec 2027). My work centers on building real-time embedded systems that turn noisy sensor data into reliable device actions (sensor-fusion firmware, BLE device links, and decoding pipelines) across three engineering internships and a signal-processing research assistantship.</p>
                        <p>That has meant fielding an <strong>RF communication-jamming demonstrator</strong> for defense clients at Syndetix, characterizing BLDC motor drive and running a design of experiments at GILZ, validating bit-error-rate performance for channel decoding in the Mitchell Coding Group, and currently solely responsible for standing up an <strong>unmanned systems production floor</strong> at ETV America. I am seeking a <strong>Summer 2027 internship</strong> in RF, embedded, and mission systems hardware.</p>
                        <p>I also serve as <strong>Vice President of the IEEE NMSU Student Chapter</strong>, where I tripled active membership from 10 to 30+, lead a <strong>$50,000</strong> fundraising initiative for the ECE department, and act as primary liaison to industry sponsors and national IEEE.</p>
                    </div>
                    <div class="panel edu-card reveal" data-delay="1">
                        <span class="panel-tag accent">&sect; Edu</span>
                        <h3>Education</h3>
                        <p class="edu-degree">B.S. Electrical Engineering</p>
                        <p class="edu-meta">New Mexico State University<br>Concentration: Communications &amp; Signal Processing<br>Expected: December 2027</p>

                        <span class="course-label">Completed coursework</span>
                        <ul class="course-list">
                            <li>Digital Logic</li>
                            <li>DC &amp; AC Circuit Analysis</li>
                            <li>Programming &amp; Embedded Systems</li>
                            <li>Linear Algebra w/ Probability &amp; Statistics</li>
                        </ul>

                        <span class="course-label">In progress / planned</span>
                        <ul class="course-list is-planned">
                            <li>Signals &amp; Systems</li>
                            <li>Digital Signal Processing</li>
                            <li>Communication Systems</li>
                            <li>Control Systems</li>
                            <li>Electromagnetics</li>
                        </ul>

                        <h3>Leadership</h3>
                        <ul>
                            <li>Vice President, IEEE NMSU Student Chapter</li>
                            <li>Tripled active membership: 10 &rarr; 30+</li>
                            <li>Lead, $50K department fundraising initiative</li>
                        </ul>
                    </div>
                </div>

                <!-- Photo Gallery -->
                <div class="gallery-section reveal">
                    <h3 class="gallery-title">// experience spotlight</h3>
                    <div class="slider-container" role="group" aria-label="Photo gallery">
                        <div class="slider-track">
                            <figure class="slide" style="--slide-bg:url('/photo5.jpg')">
                                <img src="photo5.jpg" alt="Attending the 2026 E-Council Banquet representing IEEE" loading="lazy" decoding="async" width="1400" height="1120">
                                <figcaption class="slide-caption"><span class="fig-num">FIG.01</span> Most Improved Student Organization Award</figcaption>
                            </figure>
                            <figure class="slide" data-bg="/photo4.jpg">
                                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="photo4.jpg" alt="Demonstrating my Brain-Computer Interface kit to attendees" decoding="async" width="1400" height="1050">
                                <figcaption class="slide-caption"><span class="fig-num">FIG.02</span> El Paso Science Festival 2026</figcaption>
                            </figure>
                            <figure class="slide" data-bg="/photo1.jpg">
                                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="photo1.jpg" alt="A resume workshop I hosted for students prior to a career fair" decoding="async" width="1080" height="630">
                                <figcaption class="slide-caption"><span class="fig-num">FIG.03</span> Resume Workshop</figcaption>
                            </figure>
                            <figure class="slide" data-bg="/photo2.jpg">
                                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="photo2.jpg" alt="IEEE Rising Stars Conference 2026" decoding="async" width="1049" height="1010">
                                <figcaption class="slide-caption"><span class="fig-num">FIG.04</span> IEEE Rising Stars Conference 2026</figcaption>
                            </figure>
                            <figure class="slide" data-bg="/photo3.jpg">
                                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="photo3.jpg" alt="IEEE chapter meeting with over 30 attendees" decoding="async" width="896" height="616">
                                <figcaption class="slide-caption"><span class="fig-num">FIG.05</span> IEEE Meeting: 30+ Attendees</figcaption>
                            </figure>
                        </div>
                        <button type="button" class="slider-btn prev" aria-label="Previous slide">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                        </button>
                        <button type="button" class="slider-btn next" aria-label="Next slide">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                        </button>
                        <div class="dots-container"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Where to go next -->
        <section class="section">
            <div class="container">
                <div class="section-head reveal">
                    <span class="section-index">04</span>
                    <h2 class="section-title">Where to Go Next</h2>
                </div>
                <p class="section-sub reveal">Short on time? Each page below stands on its own.</p>

                <!-- Three audiences, weighted equally. These are ordinary links,
                     so they work with or without scripting; the projects page
                     reads the lens on load. -->
                <p class="lens-jump reveal">
                    <span class="lens-jump-label">Hiring for</span>
                    <a href="/projects.html?lens=defense">defense &amp; aerospace</a>
                    <a href="/projects.html?lens=bigtech">big tech hardware</a>
                    <a href="/projects.html?lens=neurotech">neurotech &amp; BCI</a>
                </p>

                <div class="jump-grid reveal">
                    <a href="/crashguard.html" class="jump-card">
                        <span class="jump-index">01 &middot; Flagship</span>
                        <h3>CrashGuard</h3>
                        <p>IEEE MYOSA 6.0 finalist. Full technical write-up: sensor fusion, detection thresholds, and the signal-to-action chain, with a prototype video.</p>
                    </a>
                    <a href="/experience.html" class="jump-card">
                        <span class="jump-index">02 &middot; Track record</span>
                        <h3>Experience</h3>
                        <p>Four engineering roles across defense RF, unmanned systems production, motor drive, and communications research.</p>
                    </a>
                    <a href="/notes.html" class="jump-card">
                        <span class="jump-index">03 &middot; How I work</span>
                        <h3>Build Log</h3>
                        <p>Short notes on specific engineering decisions, with the measurements behind them.</p>
                    </a>
                    <a href="/skills.html" class="jump-card">
                        <span class="jump-index">04 &middot; Capability</span>
                        <h3>Skills</h3>
                        <p>RF and electronic warfare, sensor fusion and DSP, embedded firmware, PCB design, and lab &amp; test instrumentation.</p>
                    </a>
                    <a href="/Cabe_Robertson_Resume.pdf" target="_blank" class="jump-card">
                        <span class="jump-index">05 &middot; One page</span>
                        <h3>Resume (PDF)</h3>
                        <p>The same track record on a single page, for application uploads and quick reference.</p>
                    </a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .lens-jump {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 10px;
        margin: 0 0 var(--space-5);
        font-family: var(--font-mono);
        font-size: 0.78rem;
    }

    .lens-jump-label {
        color: var(--accent);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-size: 0.7rem;
    }

    .lens-jump a {
        color: var(--ink-dim);
        text-decoration: none;
        border: 1px solid var(--line);
        padding: 5px 10px;
        transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
    }

    .lens-jump a:hover,
    .lens-jump a:focus-visible { border-color: var(--accent); color: var(--ink); }

    @media (prefers-reduced-motion: reduce) {
        .lens-jump a { transition: none; }
    }
</style>
