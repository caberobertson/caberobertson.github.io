---
// Scan strip: the seven-second read. Identity, availability, eligibility and
// four hard numbers, sized to clear the fold on a 390x844 phone.
//
// Beside it on a wide screen (and under the numbers on a phone, so the read
// above still clears the fold) sits a scope: the CrashGuard detector model
// from src/lib/sim/detector.js. It is the first thing on the site a visitor
// can operate, and it does not move until they do: an animation running
// beside the name pulls the eye off the name.
//
// Every metric below is moved from the "At a Glance" block, not newly written,
// so the numbers still trace back to the resume.
const metrics = [
    { value: '1st',     label: 'IEEE MYOSA 6.0, 225+ entries from 17 countries' },
    { value: '$168K',   label: 'Capital equipment &amp; production BOM specified' },
    { value: '$2.5M',   label: 'NASA SBIR/STTR proposal co-authored' },
    { value: '~10 dB',  label: 'Acoustic noise cut in benchtop DoE' },
];
---

<header class="hero-scan">
    <div class="container scan-grid">
        <div class="scan-text">
            <p class="scan-status reveal in">
                <span class="pulse" aria-hidden="true"></span> Seeking Summer 2027 internship
            </p>

            <h1 class="scan-name reveal in">Cabe <span class="accent-word">Robertson</span></h1>

            <p class="scan-identity reveal in">
                Electrical Engineering &middot; RF, embedded, sensor fusion &amp; simulation
            </p>

            <p class="scan-facts reveal in">
                Grad Dec 2027 &middot; U.S. Person, ITAR/EAR eligible &middot; Las Cruces, NM, will relocate
            </p>

            <div class="scan-actions reveal in">
                <a href="/Cabe_Robertson_Resume.pdf" target="_blank" class="btn btn-primary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Resume
                </a>
                <a href="https://www.linkedin.com/in/caberobertson/" target="_blank" rel="noopener" class="btn">LinkedIn</a>
                <a href="mailto:caberobertson@gmail.com" class="btn">Email</a>
            </div>
        </div>

        <dl class="scan-metrics reveal in">
            {metrics.map((m) => (
                <div class="scan-metric">
                    <dt class="scan-metric-value">{m.value}</dt>
                    <dd class="scan-metric-label" set:html={m.label} />
                </div>
            ))}
        </dl>

        <!-- Detector scope. Still until a button is pressed, then it runs
             for a few seconds and stops again. Progressive: without
             JavaScript the panel is hidden (html.js gates it) and the hero is
             the plain scan strip it always was. -->
        <section class="scan-live reveal in" data-hero-scope aria-label="Live model of the CrashGuard crash detector">
            <p class="scan-live-head">
                <span class="scan-live-tag"><span class="live-dot" aria-hidden="true"></span> Try the model</span>
                <span>CrashGuard detector &middot; 100 Hz</span>
            </p>
            <canvas
                class="scan-live-canvas"
                data-scope
                role="img"
                aria-label="Strip chart of dynamic acceleration in g from a simulated accelerometer, with the 5.0 g detection threshold marked. Use the buttons below to inject events."
            ></canvas>
            <p class="scan-live-read">
                <span><b data-out="d">0.00 g</b> dynamic acceleration</span>
                <span class="scan-live-state" data-out="state" role="status">ARMED</span>
            </p>
            <div class="scan-live-controls">
                <button type="button" class="scan-live-btn" data-fire="pothole">Pothole</button>
                <button type="button" class="scan-live-btn" data-fire="glitch">Bus glitch</button>
                <button type="button" class="scan-live-btn scan-live-btn--go" data-fire="impact">Impact</button>
            </div>
            <p class="scan-live-foot">
                The detection pipeline behind our IEEE MYOSA first-place win, rebuilt as a model you can
                run. Only the impact crosses the threshold.{' '}
                <a href="/lab.html">Open the Lab<span aria-hidden="true"> &rarr;</span></a>
            </p>
        </section>
    </div>
    <div class="ruler" aria-hidden="true"></div>
</header>

<script>
    import { initHeroScope } from '../scripts/lab/impact-lab.js';

    // Wait for an idle moment: the scope is decoration until someone looks at
    // it, and the name and numbers beside it should paint first.
    const start = () => document.querySelectorAll<HTMLElement>('[data-hero-scope]').forEach(initHeroScope);
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 200);
</script>

<style>
    .hero-scan {
        padding: var(--space-6) 0 0;
    }

    /* One column on a phone: text, numbers, then the scope, so the seven-second
       read is never pushed down by a canvas. Two columns once there is room. */
    .scan-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas: 'text' 'metrics' 'live';
    }

    .scan-text { grid-area: text; min-width: 0; }
    .scan-grid > .scan-metrics { grid-area: metrics; }
    .scan-live { grid-area: live; }

    @media (min-width: 940px) {
        .scan-grid {
            grid-template-columns: minmax(0, 1fr) minmax(0, 27.5rem);
            grid-template-areas: 'text live' 'metrics metrics';
            column-gap: var(--space-7);
            align-items: end;
        }
    }

    /* ---- Live scope ---- */
    .scan-live {
        border: 1px solid var(--border-strong);
        background: var(--bg-elev);
        padding: var(--space-3) var(--space-3) var(--space-3);
        margin: 0 0 var(--space-6);
        min-width: 0;
    }

    /* The panel is inert without its script, so it only exists with it. */
    :global(html:not(.js)) .scan-live { display: none; }

    @media (min-width: 940px) {
        .scan-live { margin: 0; }
    }

    .scan-live-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-3);
        margin: 0 0 var(--space-2);
        font-family: var(--font-mono);
        font-size: max(10.5px, 0.66rem);
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--ink-dim);
    }

    .scan-live-tag { display: inline-flex; align-items: center; gap: 7px; color: var(--accent); }
    /* The marker only pulses while the model is actually running. */
    .live-dot { width: 6px; height: 6px; background: var(--accent); }
    .scan-live.is-live .live-dot { animation: pulse 2.4s infinite; }

    .scan-live-canvas {
        display: block;
        width: 100%;
        height: 168px;
        background: var(--bg);
        border: 1px solid var(--line);
    }

    .scan-live-read {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-3);
        margin: var(--space-2) 0 0;
        font-family: var(--font-mono);
        font-size: max(10.5px, 0.72rem);
        color: var(--ink-dim);
        font-variant-numeric: tabular-nums;
    }

    .scan-live-read b { color: var(--ink); font-weight: 500; font-size: 0.86rem; }
    .scan-live-state { color: var(--accent); letter-spacing: 0.6px; }
    .scan-live-state[data-tone='alert'] { color: var(--danger); }

    .scan-live-controls { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--space-3); }

    .scan-live-btn {
        font-family: var(--font-mono);
        font-size: max(10.5px, 0.72rem);
        padding: 7px 11px;
        border: 1px solid var(--border-strong);
        background: transparent;
        color: var(--ink);
        cursor: pointer;
        transition: background-color 0.15s var(--ease-out), border-color 0.15s var(--ease-out);
    }

    .scan-live-btn:hover { background: var(--hover-surface); border-color: var(--accent); }
    .scan-live-btn--go { background: var(--accent-fill); border-color: var(--accent-fill); color: var(--accent-ink); }
    .scan-live-btn--go:hover { background: var(--hover-surface); color: var(--ink); }

    .scan-live-foot {
        margin: var(--space-3) 0 0;
        font-size: 0.8rem;
        line-height: 1.55;
        color: var(--ink-dim);
    }

    .scan-live-foot a { color: var(--accent); white-space: nowrap; }

    .scan-status {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 var(--space-4);
    }

    .scan-status .pulse {
        width: 7px;
        height: 7px;
        background: var(--accent);
        flex-shrink: 0;
        animation: pulse 2.4s infinite;
    }

    .scan-name {
        font-family: var(--font-display);
        font-size: clamp(2.6rem, 9vw, 4.5rem);
        font-weight: 600;
        letter-spacing: -1px;
        line-height: 1.02;
        margin: 0;
    }

    .scan-name .accent-word {
        color: var(--accent);
    }

    .scan-identity {
        font-size: clamp(1rem, 3.6vw, 1.25rem);
        color: var(--ink);
        margin: var(--space-3) 0 0;
        max-width: 46ch;
        /* Two even lines rather than one long line and an orphaned word. */
        text-wrap: balance;
    }

    .scan-facts {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        line-height: 1.7;
        color: var(--ink-dim);
        margin: var(--space-2) 0 0;
        max-width: 62ch;
        text-wrap: balance;
    }

    .scan-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: var(--space-5);
    }

    @media (prefers-reduced-motion: reduce) {
        .scan-status .pulse, .scan-live.is-live .live-dot { animation: none; }
        .scan-live-btn { transition: none; }
    }
</style>
